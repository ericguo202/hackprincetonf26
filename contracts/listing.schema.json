{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "listing.schema.json",
  "title": "Listing",
  "description": "One entry of listings/index.json. Fields the CoStar folder does not have stay null; never fabricate them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "address", "lat", "lon", "block_id", "status", "property_type",
    "price_usd", "rent_usd_month", "tax_usd_year", "beds", "baths", "area_m2",
    "stories", "year_built", "features", "schools", "site", "has_interior",
    "world", "source"
  ],
  "$defs": {
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "address": { "type": "string" },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "block_id": {
      "type": ["string", "null"],
      "description": "The world pack this listing is placed in; null when it is in the index but on no built block"
    },
    "status": { "enum": ["for_sale", "for_rent"] },
    "property_type": {
      "enum": ["single_family", "townhouse", "condo", "duplex", "multi_family", "other"],
      "description": "From CoStar property.propertyType: 1 Detached -> single_family, 2 Townhouse -> townhouse, 4 Condo and 256 Coop -> condo, 512 Duplex -> duplex, 16 MultiFamily, 1024 Triplex and 2048 Quadruplex -> multi_family, 8 Other and 64 MobileManufactured -> other. 0 None, 32 LotsLands and 128 Commercial are not homes and are left out of the index."
    },
    "price_usd": { "type": ["number", "null"], "minimum": 0 },
    "rent_usd_month": { "type": ["number", "null"], "minimum": 0 },
    "tax_usd_year": { "type": ["number", "null"], "minimum": 0 },
    "beds": { "type": ["integer", "null"], "minimum": 0 },
    "baths": { "type": ["number", "null"], "minimum": 0 },
    "area_m2": { "type": ["number", "null"], "minimum": 0 },
    "stories": { "type": ["integer", "null"], "minimum": 1 },
    "year_built": { "type": ["integer", "null"] },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool", "parking_spaces", "garage", "fenced_yard", "utilities"],
      "properties": {
        "pool": { "type": ["boolean", "null"] },
        "parking_spaces": { "type": ["integer", "null"], "minimum": 0 },
        "garage": { "type": ["boolean", "null"] },
        "fenced_yard": { "type": ["boolean", "null"] },
        "utilities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "schools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "level", "distance_m", "rating"],
        "properties": {
          "name": { "type": "string" },
          "level": { "enum": ["elementary", "middle", "high", "other"] },
          "distance_m": { "type": ["number", "null"], "minimum": 0 },
          "rating": { "type": ["number", "null"], "minimum": 0, "maximum": 10 }
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lot_area_m2"],
      "properties": {
        "lot_area_m2": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "CoStar property.lotSizeAcresMin converted to square meters; null when CoStar has no lot size"
        }
      }
    },
    "has_interior": { "type": "boolean" },
    "world": {
      "description": "Placement of the house group in the block frame; null when the listing is not on a built block",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["position", "heading_deg", "door"],
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "heading_deg": { "type": "number" },
        "door": { "$ref": "#/$defs/vec3", "description": "House-local door point" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["costar_id", "matterport_model_id", "vexcel"],
      "properties": {
        "costar_id": { "type": "string", "description": "Raw CoStar residential listing id (MLS listing id), kept for traceability" },
        "matterport_model_id": {
          "type": ["string", "null"],
          "description": "From costar-hackathon-kit/residential-listings.csv (ListingId -> MatterportModelId). With several models, the one on the listing's 3D-tour media item (type 43), else the first CSV row"
        },
        "vexcel": { "type": ["string", "null"] }
      }
    }
  }
}
