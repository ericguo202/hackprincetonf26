{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Lane C tests also run under plain `node --experimental-strip-types`, which needs explicit .ts imports.
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    // contracts/game-state.ts lives outside this package; resolve its import from here.
    "paths": { "@colyseus/schema": ["./node_modules/@colyseus/schema"] }
  },
  "include": ["src", "../../contracts/game-state.ts"]
}
