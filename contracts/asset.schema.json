{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset.schema.json",
  "title": "Asset",
  "description": "One entry of furniture/catalog.json. Asset .glb: Y up, meters, origin at bottom center, front facing +Z, under 5 MB.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "category", "tags", "file", "size_m", "placement",
    "clearance_m", "cover", "license", "source"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+_[0-9]{2}$" },
    "name": { "type": "string" },
    "category": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "file": { "type": "string", "pattern": "^furniture/.+\\.glb$", "description": "Relative to the pack root" },
    "size_m": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "d", "h"],
      "properties": {
        "w": { "type": "number", "exclusiveMinimum": 0, "description": "Along local X" },
        "d": { "type": "number", "exclusiveMinimum": 0, "description": "Along local Z" },
        "h": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "placement": { "enum": ["wall", "corner", "free", "on_surface"] },
    "clearance_m": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "front": { "type": "number", "minimum": 0 },
        "back": { "type": "number", "minimum": 0 },
        "left": { "type": "number", "minimum": 0 },
        "right": { "type": "number", "minimum": 0 }
      }
    },
    "cover": {
      "enum": ["full", "half", "none"],
      "description": "full: taller than 1.2 m; half: 0.5 to 1.2 m; none: below 0.5 m"
    },
    "license": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 }
  }
}
