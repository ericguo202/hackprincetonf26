# Copy to .env (git-ignored). Never commit real values. In production these live in Render env vars.

# Model as provider:model (LangChain init_chat_model). Do not hard-code in code.
#   Anthropic direct:  MODEL=anthropic:claude-sonnet-4-6
#   OpenRouter:        MODEL=openrouter:anthropic/claude-sonnet-4.5   (openrouter: + the OpenRouter model slug)
MODEL=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# LangSmith tracing (on for every run). Agent-based workspace: traces go to agent + environment.
# Do NOT also set LANGSMITH_PROJECT: with both, the SDK has two destinations and traces nothing.
# Environment is one of local, development, staging, production (Render uses production).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_AGENT_ID=hackpton-realestate
LANGSMITH_AGENT_ENVIRONMENT=local

# Sponsor APIs: worldgen only (offline, never at runtime). Matterport keys are admin keys:
# use only via worldgen/sources/matterport.py, which rejects mutations.
MATTERPORT_API_TOKEN_ID=
MATTERPORT_API_TOKEN_SECRET=
VEXCEL_API_KEY=
# Matterport Showcase SDK key. Not a secret: VITE_ prefix exposes it to the browser.
# Every other key here stays server side (no VITE_ prefix).
VITE_MATTERPORT_SDK_KEY=

# CoStar: no API key. Data ships in costar-hackathon-kit/ (data/*.jsonl via Git LFS).
# worldgen/costar.py reads it and writes worldgen/out/listings/index.json.
COSTAR_KIT_DIR=costar-hackathon-kit

# World packs (worldgen publish). Bucket for uploads; base URL for all three services.
PACK_BUCKET=
# Root that mirrors worldgen/out (listings/index.json, packs/<block>/v<N>/...).
PACK_BASE_URL=
# Pack and furniture-library versions and the block the agent reads (set both versions with PACK_BASE_URL;
# locally each defaults to the newest v<N>). The furniture library is shared by every block.
PACK_VERSION=
FURNITURE_VERSION=
BLOCK_ID=hou_navidad_01
VITE_PACK_BASE_URL=
# Local pack folder the agent reads when PACK_BASE_URL is not used.
PACK_DIR=worldgen/out

# Game <-> agent internal API. Any long random string locally; Render generates it.
GAME_INTERNAL_SECRET=dev-secret-change-me
GAME_URL=http://localhost:2567

# Web client endpoints (browser-visible)
VITE_GAME_URL=ws://localhost:2567
VITE_AGENT_URL=/agent

# Fallback switches (AGENTS.md section 12)
USE_FIXTURES=1
MOCK_AGENT=0
FAKE_PLACEMENT=0
HITL=0
VITE_SOLO=0
