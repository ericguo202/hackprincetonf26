{
  "private": true,
  "name": "built-world-game",
  "version": "0.1.0",
  "description": "Colyseus multiplayer server: NeighborhoodRoom, shared state, hit validation, internal API",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
