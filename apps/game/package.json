  },
  "dependencies": {
    "@colyseus/schema": "5.0.48",
    "@colyseus/tools": "0.18.11",
    "colyseus": "0.18.12",
    "express": "5.2.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.10",
    "@colyseus/testing": "0.18.6",
    "@types/express": "5.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "mocha": "12.0.3",
    "typescript": "5.9.3"
  }
}
