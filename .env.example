# Copy to .env (git-ignored). Never commit real values.

# Model as provider:model, e.g. anthropic:<model-id>. Do not hard-code in code.
MODEL=
ANTHROPIC_API_KEY=

# LangSmith tracing (on for every run)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=built-world-sandbox

# Sponsor APIs (server side only). Matterport keys are admin keys: use only via
# apps/server/data/matterport_client.py.
MATTERPORT_API_TOKEN_ID=
MATTERPORT_API_TOKEN_SECRET=
# Matterport Showcase SDK key. Not a secret: VITE_ prefix exposes it to the browser.
# Every other key here stays server side (no VITE_ prefix).
VITE_MATTERPORT_SDK_KEY=
VEXCEL_API_KEY=

# CoStar: no API key. Data ships in costar-hackathon-kit/ (data/*.jsonl via Git LFS).
# Lane D loaders in apps/server/data/ read from here.
COSTAR_KIT_DIR=costar-hackathon-kit

# Fallback switches (AGENTS.md section 9)
USE_FIXTURES=1
MOCK_AGENT=0
FAKE_PLACEMENT=0
HITL=0
